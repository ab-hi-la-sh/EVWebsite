    "variable": [
      {
        "accountId": "0",
        "containerId": "0",
        "variableId": "2",
        "name": "CJS - CTA Page",
        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function(){\n  var el = {{Click Element}};\n  var a = el && el.closest ? el.closest('a') : el;\n  var cls = a ? (a.getAttribute('class') || '').split(/\\s+/) : [];\n  for (var i = 0; i < cls.length; i++) {\n    var m = cls[i].match(/^cta-(.+)--(.+)$/);\n    if (m) return m[1];\n  }\n  var p = {{Page Path}}.split('/').filter(Boolean);\n  return p[1] || p[0] || '(not set)';\n}"
          }
        ]
      },
      {
        "accountId": "0",
        "containerId": "0",
        "variableId": "3",
        "name": "CJS - CTA Page Section",
        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function(){\n  var el = {{Click Element}};\n  var a = el && el.closest ? el.closest('a') : el;\n  if (!a) return '(not set)';\n  var cls = (a.getAttribute('class') || '').split(/\\s+/);\n  for (var i = 0; i < cls.length; i++) {\n    var m = cls[i].match(/^cta-(.+)--(.+)$/);\n    if (m) return m[1] + ' | ' + m[2];\n  }\n  return '(not set)';\n}"
          }
        ]
      },
      {
        "accountId": "0",
        "containerId": "0",
        "variableId": "5",
        "name": "CJS - CTA Text",
        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function(){\n  var el = {{Click Element}};\n  var a = el && el.closest ? el.closest('a') : el;\n  if (!a) return '(not set)';\n  return (a.innerText || a.textContent || '').replace(/[\\u2190-\\u21FF\\u2192]/g, '').replace(/\\s+/g, ' ').trim();\n}"
          }
        ]
      },
      {
        "accountId": "0",
        "containerId": "0",
        "variableId": "6",
        "name": "CJS - CTA Name",
        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function(){\n  return {{CJS - CTA Page Section}} + ' | ' + {{CJS - CTA Text}};\n}"
          }
        ]
